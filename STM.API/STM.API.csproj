    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\STM.Infrastructure\STM.Infrastructure.csproj" />
  </ItemGroup>

